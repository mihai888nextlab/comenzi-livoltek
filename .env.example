# Parola cu care intri în aplicație (alege una lungă, de minim 12 caractere)
APP_PASSWORD=
# Cheie secretă pentru semnarea sesiunii: minim 32 de caractere aleatorii.
# Generează una cu: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Conexiunea la baza de date Postgres (Neon). Pe Vercel se completează automat
# când adaugi integrarea Neon din Storage / Marketplace.
DATABASE_URL=
